  "api_contract": [
    {
      "method": "GET",
      "path": "/api/metrics",
      "response": "{\"totalQuotes\": number, \"avgTime\": number, \"closeRate\": number}",
      "description": "Returns dashboard KPIs"
    },
    {
      "method": "GET",
      "path": "/api/quotes",
      "response": "[{id, customer, status, createdAt}]",
      "description": "Lists all quotes"
    },
    {
      "method": "POST",
      "path": "/api/quotes",
      "response": "{id, customer, pdfUrl, status}",
      "description": "Creates a new quote from smart form data"
    },
    {
      "method": "GET",
      "path": "/api/quotes/:id",
      "response": "{id, customer, details, pdfUrl}",
      "description": "Fetches a single quote"
    },
    {
      "method": "POST",
      "path": "/api/quotes/:id/accept",
      "response": "{id, status: \"accepted\", jobId}",
      "description": "Accepts a quote and triggers job scheduling"
    },
    {
      "method": "GET",
      "path": "/api/jobs",
      "response": "[{id, customer, scheduledDate, status}]",
      "description": "Lists scheduled jobs"
    },
    {
      "method": "GET",
      "path": "/api/customers",
      "response": "[{id, name, company, email}]",
      "description": "Fetches customer list"
    }
  ],
